# Required
BOT_TOKEN=

# If empty, the bot only reveals chat_id to anyone who writes /start.
# Once set, the bot only engages with this chat.
CHAT_ID=

TIMEZONE=Europe/Istanbul

# LLM (only needed when CHAT_ID is set)
LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini

# Provider keys — only fill the one you use
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# MCP (SSE) — exposes the LLM agent to external agents.
# Leave MCP_TOKEN empty to disable the MCP server entirely.
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_TOKEN=

# PB (PuhuLab QuizBot)
PB_URL=https://pb-forge.puhulab.com/quizbot
PB_EMAIL=
PB_PASSWORD=